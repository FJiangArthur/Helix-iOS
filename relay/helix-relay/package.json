{
  "name": "helix-relay",
  "version": "0.3.0",
  "private": true,
  "description": "Helix relay: tailnet-only dashboard/reminders/ask API for Helix G1/G2 (Omi, news, X, codex-proxy)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "tsc -p tsconfig.json --noEmit && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
