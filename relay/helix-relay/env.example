# helix-relay configuration. Copy to .env (git-ignored, chmod 600) or run ./setup.sh.
# Never commit real values.

# Required. Shared bearer key for every client (G1 Android app, G2 Even Hub app).
# setup.sh generates one with `openssl rand -hex 32`.
HELIX_RELAY_KEY=

# Bind address. Keep loopback; expose via `tailscale serve` (tailnet only).
HOST=127.0.0.1
PORT=8790

# Omi developer REST API key (omi_dev_…): action items + memories.
OMI_DEV_KEY=
# OMI_BASE_URL=https://api.omi.me

# Omi MCP key (omi_mcp_…): get_x_posts.
OMI_MCP_KEY=
# OMI_MCP_URL=https://api.omi.me/v1/mcp

# Finnhub API key: general market news.
FINNHUB_KEY=
# FINNHUB_BASE_URL=https://finnhub.io

# Comma-separated RSS/Atom feed URLs.
RSS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml,https://hnrss.org/frontpage

# Local codex-proxy (OpenAI-compatible). Key only if you configured proxy_api_key.
CODEX_PROXY_URL=http://127.0.0.1:8787/v1
CODEX_PROXY_KEY=
# RELAY_MODEL=gpt-5.4
# RELAY_DEEP_MODEL=gpt-5.5

# Time zone used for "Due 2pm" reminder text and the once-a-day briefing (default: system zone).
# RELAY_TZ=America/Los_Angeles

# REFRESH_MINUTES=15
# UPSTREAM_TIMEOUT_MS=20000
# RELAY_DATA_DIR=./data
# LOG_LEVEL=info
